  {
    "PID_P": {
      "val": 0.8,
      "units": " ",
      "field_name": "Proportional",
      "field_obj": "pid_proportional",
      "info": "Determines the immediate reaction to the current angular rate error. Higher values increase system stiffness and responsiveness but may cause high-frequency oscillations or motor heating if set too high."
    },
    "PID_I": {
      "val": 0.03,
      "units": " ",
      "field_name": "Integral",
      "field_obj": "pid_integral",
      "info": "Accumulates past errors to eliminate steady-state offset (drift). Essential for maintaining exact heading against constant disturbances like wind or mechanical imbalance. Excessive values lead to slow 'wind-up' and sluggish recovery after large maneuvers. More I = better at remembering to correct long-term drift, but it can make the system feel \"heavy\" or slow to react if overdone."
    },
    "PID_D": {
      "val": 0.05,
      "units": " ",
      "field_name": "Differential",
      "field_obj": "pid_differential",
      "info": "Predicts future error based on the rate of change of the gyro signal. Acts as a damper to suppress overshoot and smooth out rapid stick inputs. More D = smoother stops and less bouncing, but it makes the motors work harder against tiny sensor vibrations."
    }
  },
